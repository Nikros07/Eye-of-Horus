# Copy to .env and adjust. Never commit the real .env file.

APP_NAME="Eye of Horus"
ENVIRONMENT=development

# sqlite:///./eye_of_horus.db for local dev (zero infra).
# postgresql+psycopg2://user:password@host:5432/dbname for production.
DATABASE_URL=sqlite:///./eye_of_horus.db

# demo = deterministic seeded generators (NASA/NOAA/market APIs not called).
# live  = real connectors (NASA EONET, Open-Meteo, yfinance) — requires
#         outbound network access to those hosts.
DATA_MODE=demo

# demo = synthetic deterministic price series.
# yfinance = real Yahoo Finance data via the yfinance package.
MARKET_DATA_PROVIDER=demo

# Trading safety. Must be explicitly set to true AND a real broker adapter
# implemented before any live order can ever be placed. Defaults to false
# everywhere for a reason — leave it alone unless you mean it.
LIVE_TRADING_ENABLED=false

# internal = PaperBroker simulates fills in-process (default, zero setup).
# alpaca   = AlpacaBroker submits real orders to Alpaca's free PAPER
#            trading account (real fills/market data, still fake money).
#            Only affects the paper portfolio — "live" mode is untouched.
#            Requires the two keys below; get them free at alpaca.markets
#            (dashboard -> Paper Trading -> API Keys).
BROKER_PROVIDER=internal
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

DEFAULT_PAPER_CAPITAL=10000

# anthropic = ClaudeProvider (needs ANTHROPIC_API_KEY below).
# gemini    = GeminiProvider (needs GEMINI_API_KEY below) — free-tier key,
#             no card required, from https://aistudio.google.com/apikey.
# Without a key for whichever is selected, the AI research layer falls back
# to the deterministic evidence synthesizer (never fabricates facts either way).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

CORS_ORIGINS=["http://localhost:3000"]

INGESTION_INTERVAL_SECONDS=300
