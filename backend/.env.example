# Copy to .env and adjust. Never commit the real .env file.

APP_NAME="Eye of Horus"
ENVIRONMENT=development

# sqlite:///./eye_of_horus.db for local dev (zero infra).
# postgresql+psycopg2://user:password@host:5432/dbname for production.
DATABASE_URL=sqlite:///./eye_of_horus.db

# demo = deterministic seeded generators (NASA/NOAA/market APIs not called).
# live  = real connectors (NASA EONET, Open-Meteo, yfinance) — requires
#         outbound network access to those hosts.
DATA_MODE=demo

# demo = synthetic deterministic price series.
# yfinance = real Yahoo Finance data via the yfinance package.
MARKET_DATA_PROVIDER=demo

# Trading safety. Must be explicitly set to true AND a real broker adapter
# implemented before any live order can ever be placed. Defaults to false
# everywhere for a reason — leave it alone unless you mean it.
LIVE_TRADING_ENABLED=false

DEFAULT_PAPER_CAPITAL=10000

# Optional. If set, the AI research layer calls the Claude API for
# evidence synthesis instead of the deterministic fallback synthesizer.
ANTHROPIC_API_KEY=

CORS_ORIGINS=["http://localhost:3000"]

INGESTION_INTERVAL_SECONDS=300
