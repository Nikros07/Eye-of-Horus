# Copy to .env.local and adjust. Never commit the real .env.local file.
#
# Only `next dev`/`next build` read this file directly. docker-compose sets
# NEXT_PUBLIC_API_BASE itself as a build arg (see docker-compose.yml), and
# the GitHub Pages workflow sets BUILD_TARGET/NEXT_PUBLIC_API_BASE itself as
# job env (see .github/workflows/gh-pages.yml) — this file only matters for
# running the frontend directly on your own machine.

# Required. Base URL the BROWSER uses to reach the backend API. Must be
# reachable from wherever the user's browser runs (not just from inside
# Docker), so in a docker-compose setup this stays a host-facing localhost
# URL, not the internal service name.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Optional. Leave unset for a normal server build (`next start`, what
# docker-compose runs). Set to "github-pages" to instead produce the static
# `out/` export used for GitHub Pages (`next.config.js` switches to
# `output: "export"` and adds a `/Eye-of-Horus` basePath) — set this only if
# you want to preview that static build locally.
# BUILD_TARGET=github-pages

# Optional, only read when BUILD_TARGET=github-pages. Overrides the
# GitHub Pages basePath (default "/Eye-of-Horus"); set it if you forked or
# renamed the repo, so a project-site deploy serves from the right path.
# The app derives NEXT_PUBLIC_BASE_PATH from this automatically at build
# time (see frontend/lib/basePath.ts) — don't set NEXT_PUBLIC_BASE_PATH
# directly, it would just be overwritten by that computed value.
# GH_PAGES_BASE_PATH=/Eye-of-Horus
